local toggles = {}

local function createToggle(name, callback)
	local button = createButton(
		content,
		name .. "   ⬜",
		UDim2.new(1, -5, 0, 42),
		UDim2.new()
	)

	local active = false

	button.MouseButton1Click:Connect(function()
		active = not active

		button.Text = name .. "   " .. (active and "🟩" or "⬜")

		callback(active)
	end)

	toggles[name] = {
		Button = button,
		Get = function()
			return active
		end
	}

	return button
end

