local CreatorKey = "LK7CREATOR"
local KEY_TIME = 24 * 60 * 60

local Keys = {}
local PlayerKeys = {}

local State = {}

local function getState(player)
	if not State[player] then
		State[player] = {
			Invisibility = false,
			Speed = false,
			Fly = false,
			AntiAFK = false,
			AutoPlaceEgg = false,
			AntiSlap = false,
			AutoConveyor = false,
			Steal = false,
			Instant = false,
			ESP = false
		}
	end

	return State[player]
end

local function setInvisible(player, enabled)
	local character = player.Character
	if not character then return end

	for _, object in ipairs(character:GetDescendants()) do
		if object:IsA("BasePart") then
			if object.Name ~= "HumanoidRootPart" then
				object.Transparency = enabled and 1 or 0
			end
		elseif object:IsA("Decal") then
			object.Transparency = enabled and 1 or 0
		end
	end
end

local function applyCharacterSettings(player)
	local state = getState(player)
	local character = player.Character

	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		humanoid.WalkSpeed = state.Speed and 32 or 16
	end

	setInvisible(player, state.Invisibility)
end

Players.PlayerAdded:Connect(function(player)
	getState(player)

	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		applyCharacterSettings(player)
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	State[player] = nil
	PlayerKeys[player] = nil
end)

GenerateKey.OnServerInvoke = function(player)
	local key = "MOBY-" .. string.upper(HttpService:GenerateGUID(false):gsub("-", ""))

	Keys[key] = {
		Owner = player.UserId,
		Expires = os.time() + KEY_TIME,
		Used = false
	}

	return key
end

CheckKey.OnServerInvoke = function(player, key)
	if typeof(key) ~= "string" then
		return false, "Chave inválida."
	end

	key = key:gsub("%s+", "")

	if key == CreatorKey then
		PlayerKeys[player] = {
			Permanent = true,
			Expires = math.huge
		}

		return true, "CREATOR"
	end

	local data = Keys[key]

	if not data then
		return false, "Chave não encontrada."
	end

	if data.Used then
		return false, "Esta chave já foi usada."
	end

	if os.time() >= data.Expires then
		Keys[key] = nil
		return false, "Esta chave expirou."
	end

	data.Used = true

	PlayerKeys[player] = {
		Permanent = false,
		Expires = data.Expires
	}

	return true, data.Expires
end

ToggleInvisibility.OnServerEvent:Connect(function(player, enabled)
	local state = getState(player)

	state.Invisibility = enabled == true

