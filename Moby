-- EXPIRAÇÃO DA KEY
--------------------------------------------------

task.spawn(function()

	while true do

		task.wait(1)

		if unlocked and not creator and keyExpiration > 0 then

			if os.time() >= keyExpiration then

				unlocked = false
				keyExpiration = 0

				menu.Visible = false
				keyFrame.Visible = true

				keyBox.Text = ""

				status.Text =
					"Sua Key expirou. Gere uma nova."

				status.TextColor3 =
					Color3.fromRGB(255, 170, 80)
			end
		end
	end
end)

