				UDim2.new(0.8, 0, 0, 35),
				UDim2.new(0.1, 0, 0, 90)
			)

			local closed = false

			local function closeCreator()
				if closed then return end

				closed = true

				if creatorFrame then
					creatorFrame:Destroy()
				end
			end

			close.MouseButton1Click:Connect(closeCreator)

			task.delay(3, closeCreator)

		else

			keyExpiration = tonumber(message) or 0

			status.Text = "Key válida!"

			status.TextColor3 =
				Color3.fromRGB(100, 255, 120)
		end

	else

		status.Text = tostring(message)

		status.TextColor3 =
			Color3.fromRGB(255, 100, 100)
	end
end)

